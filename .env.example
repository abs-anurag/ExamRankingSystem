# ==============================================================
# ExamRank — Database Environment Configuration (.env.example)
# Copy this file to .env for local development:
#   cp .env.example .env
# Note: NEVER commit .env files containing real passwords to git.
# ==============================================================

# Option 1: Railway MySQL Variables (Recommended for Cloud Deployment)
# When deploying to Railway with a MySQL plugin, Railway provides these automatically:
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=exam_ranking_system
MYSQLUSER=root
MYSQLPASSWORD=your_local_mysql_password

# Option 2: Generic Discrete Variables (Alternative for Local / Cloud)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=exam_ranking_system
# DB_USER=root
# DB_PASSWORD=your_local_mysql_password

# Option 3: Full JDBC URL (Alternative)
# DB_URL=jdbc:mysql://localhost:3306/exam_ranking_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=your_local_mysql_password

# Optional: Custom JDBC Connection Query Parameters
# DB_PARAMS=useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

